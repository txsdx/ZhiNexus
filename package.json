{
  "name": "zhinexus",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "tauri": "tauri",
    "check": "tsc -b",
    "format": "prettier --write src tests *.ts *.json .github src-tauri/*.json src-tauri/capabilities/*.json",
    "test:e2e": "playwright test",
    "version:bump": "node scripts/versions.mjs bump",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-sql": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@xyflow/react": "^12.8.0",
    "diff": "^8.0.4",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "katex": "^0.18.2",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.13.0",
    "ts-fsrs": "^5.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  }
}
